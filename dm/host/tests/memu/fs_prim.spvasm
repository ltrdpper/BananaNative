; A pixel shader of a per-primitive input as the library build leaves one (vk_android_spv.py per_primitive_inputs; written by hand, no game code): location 1
; PerPrimitiveEXT and Flat, location 0 interpolated; colour = in0 + in1
               OpCapability Shader
               OpCapability MeshShadingEXT
               OpExtension "SPV_EXT_mesh_shader"
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in0 %in1 %col
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %in0 Location 0
               OpDecorate %in1 Location 1
               OpDecorate %in1 PerPrimitiveEXT
               OpDecorate %in1 Flat
               OpDecorate %col Location 0
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
    %v4float = OpTypeVector %float 4
     %p_in_v4 = OpTypePointer Input %v4float
    %p_out_v4 = OpTypePointer Output %v4float
        %in0 = OpVariable %p_in_v4 Input
        %in1 = OpVariable %p_in_v4 Input
        %col = OpVariable %p_out_v4 Output
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %a = OpLoad %v4float %in0
          %b = OpLoad %v4float %in1
          %c = OpFAdd %v4float %a %b
               OpStore %col %c
               OpReturn
               OpFunctionEnd
