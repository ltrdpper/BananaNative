#version 450
#extension GL_GOOGLE_include_directive : require
// NVN2's DLSS stand-in (vka_dlss.c): AMD's RCAS on the output-size work image (FSR 1's EASU or GSR2's scene colour, both tonemapped), then, with pc.itm, the tonemap
// undone (c / (1 - max(c))) back to the linear colour the game's post chain expects, and with pc.enc the sRGB encoding of an sRGB output texture (the replay stores
// sRGB textures as their UNORM twin, and the blit that follows moves the values as they are). con0.x is RCAS's sharpness as a linear factor (DM_VK_DLSS_SHARP / 100)
//
// AMD's FsrRcasF (ffx_fsr1.h, 32-bit path, no denoise, no alpha), written out as fsr/ndsr_rcas.comp has it: its two limiters divide by values kept at least 2^-20 away
// from zero instead of taking exact reciprocals, which are infinite where the ring is black (0) or white (1); 0 * inf is NaN, which AMD's code expects min / max to drop,
// and Qualcomm's driver does not (docs/reference/shaders.md, FSR's RCAS wrote NaN on Qualcomm's driver)
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P { uvec4 con0; ivec2 size; int itm; int enc; } pc;
#include "dlss_srgb.h"
const float RCAS_LIMIT = 0.25 - 1.0 / 16.0;   // FSR_RCAS_LIMIT
const float TINY = 1.0 / 1048576.0;
// Clamped: RCAS reads a 3x3 neighbourhood
vec3 ld(ivec2 p) { return texelFetch(tex, clamp(p, ivec2(0), pc.size - 1), 0).rgb; }
float rmax3(float a, float b, float c) { return max(a, max(b, c)); }
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    //    b
    //  d e f
    //    h
    vec3 b = ld(p + ivec2(0, -1)), d = ld(p + ivec2(-1, 0)), e = ld(p), f = ld(p + ivec2(1, 0)), h = ld(p + ivec2(0, 1));
    vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(TINY));                       // AMD: min(mn4, e) * rcp(4 * mx4)
    vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-TINY));        // AMD: (1 - max(mx4, e)) * rcp(4 * mn4 - 4)
    vec3 lobe3 = max(-hitMin, hitMax);
    float lobe = max(-RCAS_LIMIT, min(rmax3(lobe3.r, lobe3.g, lobe3.b), 0.0)) * uintBitsToFloat(pc.con0.x);
    vec3 c = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);                   // (4 * lobe + 1 >= 0.25)
    c = clamp(c, 0.0, 1.0);
    if (pc.itm != 0) c /= max(1.0 - max(c.r, max(c.g, c.b)), 1.0 / 1024.0);
    if (pc.enc != 0) c = dlss_srgb_enc(c);
    imageStore(dst, p, vec4(c, 1.0));
}
